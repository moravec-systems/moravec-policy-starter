{
  "$defs": {
    "CoordinatedAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "coordinated",
          "title": "Kind",
          "type": "string"
        },
        "tracks": {
          "items": {
            "discriminator": {
              "mapping": {
                "gripper-command": "#/$defs/GripperCommand",
                "joint-trajectory": "#/$defs/JointTrajectory",
                "pose-trajectory": "#/$defs/PoseTrajectory"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/JointTrajectory"
              },
              {
                "$ref": "#/$defs/PoseTrajectory"
              },
              {
                "$ref": "#/$defs/GripperCommand"
              }
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "tracks"
      ],
      "title": "CoordinatedAction",
      "type": "object"
    },
    "GripperCommand": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "gripper-command",
          "title": "Kind",
          "type": "string"
        },
        "gripper": {
          "title": "Gripper",
          "type": "string"
        },
        "open_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Open Fraction",
          "type": "number"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Duration S",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "gripper",
        "open_fraction",
        "duration_s"
      ],
      "title": "GripperCommand",
      "type": "object"
    },
    "JointPoint": {
      "additionalProperties": false,
      "properties": {
        "time_from_start_s": {
          "exclusiveMinimum": 0,
          "title": "Time From Start S",
          "type": "number"
        },
        "positions": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Positions",
          "type": "object"
        },
        "grippers": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Grippers",
          "type": "object"
        }
      },
      "required": [
        "time_from_start_s",
        "positions"
      ],
      "title": "JointPoint",
      "type": "object"
    },
    "JointTrajectory": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "joint-trajectory",
          "title": "Kind",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/JointPoint"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "execution_horizon": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Horizon"
        }
      },
      "required": [
        "kind",
        "points"
      ],
      "title": "JointTrajectory",
      "type": "object"
    },
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "title": "Frame",
          "type": "string"
        },
        "position_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position M",
          "type": "array"
        },
        "orientation_wxyz": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Orientation Wxyz",
          "type": "array"
        }
      },
      "required": [
        "frame",
        "position_m",
        "orientation_wxyz"
      ],
      "title": "Pose",
      "type": "object"
    },
    "PosePoint": {
      "additionalProperties": false,
      "properties": {
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "gripper_open_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gripper Open Fraction"
        }
      },
      "required": [
        "pose"
      ],
      "title": "PosePoint",
      "type": "object"
    },
    "PoseTrajectory": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pose-trajectory",
          "title": "Kind",
          "type": "string"
        },
        "arm": {
          "title": "Arm",
          "type": "string"
        },
        "representation": {
          "enum": [
            "absolute",
            "relative"
          ],
          "title": "Representation",
          "type": "string"
        },
        "reference": {
          "default": "frame",
          "enum": [
            "frame",
            "tool"
          ],
          "title": "Reference",
          "type": "string"
        },
        "relative_to": {
          "default": "observation",
          "enum": [
            "observation",
            "previous"
          ],
          "title": "Relative To",
          "type": "string"
        },
        "timestep_s": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Timestep S",
          "type": "number"
        },
        "execution_horizon": {
          "exclusiveMinimum": 0,
          "title": "Execution Horizon",
          "type": "integer"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/PosePoint"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "arm",
        "representation",
        "timestep_s",
        "execution_horizon",
        "points"
      ],
      "title": "PoseTrajectory",
      "type": "object"
    },
    "Stop": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "stop",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "Stop",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "moravec.decision/v0.3",
      "default": "moravec.decision/v0.3",
      "title": "Schema Version",
      "type": "string"
    },
    "episode_id": {
      "title": "Episode Id",
      "type": "string"
    },
    "observation_sequence": {
      "title": "Observation Sequence",
      "type": "integer"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "valid_until_station_time_s": {
      "title": "Valid Until Station Time S",
      "type": "number"
    },
    "evidence_kind": {
      "enum": [
        "model-inference",
        "contract-fixture"
      ],
      "title": "Evidence Kind",
      "type": "string"
    },
    "action": {
      "discriminator": {
        "mapping": {
          "coordinated": "#/$defs/CoordinatedAction",
          "gripper-command": "#/$defs/GripperCommand",
          "joint-trajectory": "#/$defs/JointTrajectory",
          "pose-trajectory": "#/$defs/PoseTrajectory",
          "stop": "#/$defs/Stop"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/JointTrajectory"
        },
        {
          "$ref": "#/$defs/PoseTrajectory"
        },
        {
          "$ref": "#/$defs/GripperCommand"
        },
        {
          "$ref": "#/$defs/CoordinatedAction"
        },
        {
          "$ref": "#/$defs/Stop"
        }
      ],
      "title": "Action"
    }
  },
  "required": [
    "episode_id",
    "observation_sequence",
    "decision_id",
    "valid_until_station_time_s",
    "evidence_kind",
    "action"
  ],
  "title": "Decision",
  "type": "object"
}
