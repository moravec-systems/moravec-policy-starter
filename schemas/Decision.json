{
  "$defs": {
    "ActionChunk": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "action-chunk",
          "default": "action-chunk",
          "title": "Kind",
          "type": "string"
        },
        "timestep_s": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Timestep S",
          "type": "number"
        },
        "execution_horizon": {
          "exclusiveMinimum": 0,
          "title": "Execution Horizon",
          "type": "integer"
        },
        "omitted_targets": {
          "const": "hold-start",
          "default": "hold-start",
          "title": "Omitted Targets",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/ActionStep"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "timestep_s",
        "execution_horizon",
        "steps"
      ],
      "title": "ActionChunk",
      "type": "object"
    },
    "ActionStep": {
      "additionalProperties": false,
      "properties": {
        "joint_positions": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Joint Positions",
          "type": "object"
        },
        "tcp_targets": {
          "additionalProperties": {
            "$ref": "#/$defs/PoseTarget"
          },
          "title": "Tcp Targets",
          "type": "object"
        },
        "grippers": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Grippers",
          "type": "object"
        }
      },
      "title": "ActionStep",
      "type": "object"
    },
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "title": "Frame",
          "type": "string"
        },
        "position_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position M",
          "type": "array"
        },
        "orientation_wxyz": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Orientation Wxyz",
          "type": "array"
        }
      },
      "required": [
        "frame",
        "position_m",
        "orientation_wxyz"
      ],
      "title": "Pose",
      "type": "object"
    },
    "PoseTarget": {
      "additionalProperties": false,
      "properties": {
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "representation": {
          "default": "absolute",
          "enum": [
            "absolute",
            "relative"
          ],
          "title": "Representation",
          "type": "string"
        },
        "reference": {
          "default": "frame",
          "enum": [
            "frame",
            "tool"
          ],
          "title": "Reference",
          "type": "string"
        },
        "relative_to": {
          "default": "observation",
          "enum": [
            "observation",
            "previous"
          ],
          "title": "Relative To",
          "type": "string"
        }
      },
      "required": [
        "pose"
      ],
      "title": "PoseTarget",
      "type": "object"
    },
    "Stop": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "stop",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "Stop",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "moravec.decision/v0.4",
      "default": "moravec.decision/v0.4",
      "title": "Schema Version",
      "type": "string"
    },
    "episode_id": {
      "title": "Episode Id",
      "type": "string"
    },
    "observation_sequence": {
      "title": "Observation Sequence",
      "type": "integer"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "valid_until_station_time_s": {
      "title": "Valid Until Station Time S",
      "type": "number"
    },
    "evidence_kind": {
      "enum": [
        "model-inference",
        "contract-fixture"
      ],
      "title": "Evidence Kind",
      "type": "string"
    },
    "action": {
      "discriminator": {
        "mapping": {
          "action-chunk": "#/$defs/ActionChunk",
          "stop": "#/$defs/Stop"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ActionChunk"
        },
        {
          "$ref": "#/$defs/Stop"
        }
      ],
      "title": "Action"
    }
  },
  "required": [
    "episode_id",
    "observation_sequence",
    "decision_id",
    "valid_until_station_time_s",
    "evidence_kind",
    "action"
  ],
  "title": "Decision",
  "type": "object"
}
