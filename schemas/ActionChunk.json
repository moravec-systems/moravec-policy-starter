{
  "$defs": {
    "EEStep": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ee",
          "title": "Kind",
          "type": "string"
        },
        "left": {
          "items": {
            "type": "number"
          },
          "maxItems": 7,
          "minItems": 7,
          "title": "Left",
          "type": "array"
        },
        "right": {
          "items": {
            "type": "number"
          },
          "maxItems": 7,
          "minItems": 7,
          "title": "Right",
          "type": "array"
        },
        "left_gripper": {
          "maximum": 1,
          "minimum": 0,
          "title": "Left Gripper",
          "type": "number"
        },
        "right_gripper": {
          "maximum": 1,
          "minimum": 0,
          "title": "Right Gripper",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "left",
        "right",
        "left_gripper",
        "right_gripper"
      ],
      "title": "EEStep",
      "type": "object"
    },
    "JointStep": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "joint",
          "title": "Kind",
          "type": "string"
        },
        "left": {
          "items": {
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Left",
          "type": "array"
        },
        "right": {
          "items": {
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Right",
          "type": "array"
        },
        "left_gripper": {
          "maximum": 1,
          "minimum": 0,
          "title": "Left Gripper",
          "type": "number"
        },
        "right_gripper": {
          "maximum": 1,
          "minimum": 0,
          "title": "Right Gripper",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "left",
        "right",
        "left_gripper",
        "right_gripper"
      ],
      "title": "JointStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "episode_id": {
      "title": "Episode Id",
      "type": "string"
    },
    "observation_sequence": {
      "minimum": 0,
      "title": "Observation Sequence",
      "type": "integer"
    },
    "action_type": {
      "enum": [
        "joint",
        "ee"
      ],
      "title": "Action Type",
      "type": "string"
    },
    "frame_profile": {
      "const": "robodojo-arx-x5-native/v1",
      "default": "robodojo-arx-x5-native/v1",
      "title": "Frame Profile",
      "type": "string"
    },
    "timestep_s": {
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Timestep S",
      "type": "number"
    },
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "ee": "#/$defs/EEStep",
            "joint": "#/$defs/JointStep"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/JointStep"
          },
          {
            "$ref": "#/$defs/EEStep"
          }
        ]
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "evidence_kind": {
      "enum": [
        "model_inference",
        "mock"
      ],
      "title": "Evidence Kind",
      "type": "string"
    }
  },
  "required": [
    "episode_id",
    "observation_sequence",
    "action_type",
    "timestep_s",
    "steps",
    "evidence_kind"
  ],
  "title": "ActionChunk",
  "type": "object"
}
