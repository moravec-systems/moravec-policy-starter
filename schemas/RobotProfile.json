{
  "$defs": {
    "Joint": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "enum": [
            "rad",
            "m"
          ],
          "title": "Unit",
          "type": "string"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "name",
        "unit",
        "lower",
        "upper"
      ],
      "title": "Joint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "string"
    },
    "joints": {
      "items": {
        "$ref": "#/$defs/Joint"
      },
      "minItems": 1,
      "title": "Joints",
      "type": "array"
    },
    "frames": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Frames",
      "type": "array"
    },
    "cameras": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Cameras",
      "type": "array"
    },
    "control_period_s": {
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Control Period S",
      "type": "number"
    },
    "max_observation_age_s": {
      "exclusiveMinimum": 0,
      "maximum": 10,
      "title": "Max Observation Age S",
      "type": "number"
    },
    "max_camera_skew_s": {
      "maximum": 1,
      "minimum": 0,
      "title": "Max Camera Skew S",
      "type": "number"
    },
    "max_action_duration_s": {
      "exclusiveMinimum": 0,
      "maximum": 30,
      "title": "Max Action Duration S",
      "type": "number"
    }
  },
  "required": [
    "id",
    "revision",
    "joints",
    "frames",
    "cameras",
    "control_period_s",
    "max_observation_age_s",
    "max_camera_skew_s",
    "max_action_duration_s"
  ],
  "title": "RobotProfile",
  "type": "object"
}
