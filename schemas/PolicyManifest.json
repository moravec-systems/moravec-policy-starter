{
  "$defs": {
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        },
        "provider_model_id": {
          "title": "Provider Model Id",
          "type": "string"
        },
        "artifact_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Uri"
        },
        "artifact_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Revision"
        },
        "checkpoint_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Sha256"
        }
      },
      "required": [
        "name",
        "provider_model_id"
      ],
      "title": "ModelIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "moravec.policy/v0.5",
      "title": "Schema Version",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelIdentity"
    },
    "family": {
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "title": "Family",
      "type": "string"
    },
    "harness_version": {
      "title": "Harness Version",
      "type": "string"
    },
    "entrypoint": {
      "minLength": 3,
      "title": "Entrypoint",
      "type": "string"
    },
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "required_camera_channels": {
      "additionalProperties": {
        "items": {
          "enum": [
            "rgb",
            "depth",
            "intrinsics",
            "extrinsics"
          ],
          "type": "string"
        },
        "type": "array"
      },
      "title": "Required Camera Channels",
      "type": "object"
    },
    "runtime_profile": {
      "enum": [
        "isolated",
        "api-connected"
      ],
      "title": "Runtime Profile",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "model",
    "family",
    "harness_version",
    "entrypoint",
    "runtime_profile"
  ],
  "title": "PolicyManifest",
  "type": "object"
}
