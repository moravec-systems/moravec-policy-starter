{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "moravec.deployment/v0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "image": {
      "pattern": "^.+@sha256:[0-9a-f]{64}$",
      "title": "Image",
      "type": "string"
    },
    "registry_pull_secret_ref": {
      "title": "Registry Pull Secret Ref",
      "type": "string"
    },
    "network_profile": {
      "enum": [
        "isolated",
        "api-connected"
      ],
      "title": "Network Profile",
      "type": "string"
    },
    "model_endpoint_allowlist": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Model Endpoint Allowlist",
      "type": "array"
    },
    "results_destination": {
      "title": "Results Destination",
      "type": "string"
    },
    "results_write_secret_ref": {
      "title": "Results Write Secret Ref",
      "type": "string"
    },
    "retention_days": {
      "minimum": 0,
      "title": "Retention Days",
      "type": "integer"
    },
    "publication_opt_in": {
      "default": false,
      "title": "Publication Opt In",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "image",
    "registry_pull_secret_ref",
    "network_profile",
    "results_destination",
    "results_write_secret_ref",
    "retention_days"
  ],
  "title": "DeploymentManifest",
  "type": "object"
}
