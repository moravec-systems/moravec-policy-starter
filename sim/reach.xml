<mujoco model="moravec-contract-reach">
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <visual><global offwidth="320" offheight="240"/></visual>
  <default><joint damping="2"/><geom density="800" rgba="0.35 0.4 0.45 1"/></default>
  <worldbody>
    <light pos="0 0 2"/>
    <geom type="plane" size="1 1 .01" rgba=".8 .8 .8 1"/>
    <camera name="overview" pos="0.25 0.1 1.2" xyaxes="1 0 0 0 1 0"/>
    <body name="upper" pos="0 0 .08">
      <joint name="shoulder" type="hinge" axis="0 0 1" range="-160 160"/>
      <geom type="capsule" fromto="0 0 0 .3 0 0" size=".025"/>
      <body name="forearm" pos=".3 0 0">
        <joint name="elbow" type="hinge" axis="0 0 1" range="-160 160"/>
        <geom type="capsule" fromto="0 0 0 .25 0 0" size=".02" rgba=".2 .45 .6 1"/>
        <site name="tcp" pos=".25 0 0" size=".02" rgba=".9 .2 .2 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position joint="shoulder" kp="100" kv="15"/>
    <position joint="elbow" kp="100" kv="15"/>
  </actuator>
</mujoco>
